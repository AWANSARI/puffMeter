// Copy to Config/Secrets.xcconfig (git-ignored) and replace with your Google Cloud iOS OAuth client.
// Note: "//" starts a comment in xcconfig, so URLs can't be written here; client IDs have no slashes.
GOOGLE_CLIENT_ID = 1234567890-abcdefg.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefg
